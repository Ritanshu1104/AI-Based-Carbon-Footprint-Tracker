# Copy this file to .env. Never commit the real .env file.
# Server-restricted key: enable Routes API and Places API (New).
GOOGLE_MAPS_API_KEY=

# Browser/referrer-restricted key: enable Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=

# Optional self-hosted routing fallback.
OSRM_BASE_URL=https://router.project-osrm.org
