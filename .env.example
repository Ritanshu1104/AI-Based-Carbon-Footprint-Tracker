# Copy this file to .env. Never commit the real .env file.
# Server-restricted key: enable Routes API and Places API (New).
GOOGLE_MAPS_API_KEY=

# Browser/referrer-restricted key: enable Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=

# Google OAuth web client. Add this exact redirect URI in Google Cloud:
# http://127.0.0.1:5000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

# Optional self-hosted routing fallback.
OSRM_BASE_URL=https://router.project-osrm.org
